{
  "name": "claude-code-agent-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, evidence-grounded reliability traces for Claude Code public hooks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/shell-quote": "^1.7.5",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "shell-quote": "^1.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0"
  }
}
